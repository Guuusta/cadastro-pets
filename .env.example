# ============================================================
# MODELO de configuração. Copie para ".env" e ajuste:
#   cp .env.example .env
# O ".env" de verdade NUNCA vai para o Git (está no .gitignore).
#
# A SENHA do banco não fica aqui: ela é um "secret", num arquivo separado:
#   mkdir -p secrets && printf '%s' 'sua-senha' > secrets/db_password.txt
# ============================================================

# Banco de dados PostgreSQL (nomes, não são segredo)
POSTGRES_DB=pets
POSTGRES_USER=pets

# Versão de cada imagem (tag). Cada app tem a SUA versão:
# mudou o código da API? Sobe só a API_VERSION.
API_VERSION=0.4.0
WEB_VERSION=0.2.1

# Porta do proxy no seu PC (padrão 80)
PROXY_PORT=80
PROXY_HTTPS_PORT=443
