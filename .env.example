# ============================================================
# MODELO de configuração. Copie para ".env" e ajuste:
#   cp .env.example .env
# O ".env" de verdade NUNCA vai para o Git (está no .gitignore).
#
# As SENHAS não ficam aqui: são "secrets", em arquivos separados:
#   mkdir -p secrets
#   printf '%s' 'senha-do-banco'   > secrets/db_password.txt
#   printf '%s' 'senha-do-grafana' > secrets/grafana_admin_password.txt   (só para o monitoramento)
# ============================================================

# Banco de dados PostgreSQL (nomes, não são segredo)
POSTGRES_DB=pets
POSTGRES_USER=pets

# Versão de cada imagem (tag). Cada app tem a SUA versão:
# mudou o código da API? Sobe só a API_VERSION.
API_VERSION=0.5.0
WEB_VERSION=0.2.1

# Porta do proxy no seu PC (padrão 80)
PROXY_PORT=80
PROXY_HTTPS_PORT=443

# Registry de onde vêm as imagens (publicadas pelo CI/CD no GitHub)
REGISTRY=ghcr.io/guuusta
