# ============================================================
# MODELO de configuração. Copie para ".env" e troque os valores:
#   cp .env.example .env
# O ".env" de verdade NUNCA vai para o Git (está no .gitignore).
# ============================================================

# Banco de dados PostgreSQL
POSTGRES_DB=pets
POSTGRES_USER=pets
POSTGRES_PASSWORD=troque-esta-senha

# Versão de cada imagem (tag). Cada app tem a SUA versão:
# mudou o código da API? Sobe só a API_VERSION.
API_VERSION=0.1.1
WEB_VERSION=0.1.0
